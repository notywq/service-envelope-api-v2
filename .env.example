# API Configuration
PORT=8000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
JWT_ISSUER=service-envelope-api
JWT_AUDIENCE=service-envelope-clients

# Auth / OTP
# Development default: API auth middleware is off. Production defaults to auth required unless AUTH_REQUIRED=false is explicitly set.
AUTH_REQUIRED=false

# OTP allowed users and roles are stored in MongoDB authusers collection.
# Manage them with /api/admin/auth-users as a super_admin.
OTP_SECRET=change-this-otp-hmac-secret-in-production
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_TEMPLATE_ID=otp-login
# Development only: include OTP in JSON response when SMTP is not configured.
OTP_ECHO_IN_RESPONSE=false

# MongoDB
# Startup tries the SRV URI first. If Node DNS returns querySrv ECONNREFUSED,
# it automatically retries MONGODB_DIRECT_URI.
MONGODB_SRV_URI=mongodb+srv://username:password@cluster.mongodb.net/service-envelope?retryWrites=true&w=majority
MONGODB_DIRECT_URI=mongodb://username:password@host-00-00.mongodb.net:27017,host-00-01.mongodb.net:27017,host-00-02.mongodb.net:27017/service-envelope?ssl=true&replicaSet=your-replica-set&authSource=admin&appName=service-envelope

# Alternative non-SRV URI:
# MONGODB_URI=mongodb://username:password@host:27017/service-envelope

# Email (Nodemailer - Office365/Mapua sender)
EMAIL_HOST=smtp-legacy.office365.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=processor@mapua.edu.ph
EMAIL_PASSWORD=your-office365-smtp-password
EMAIL_FROM=processor@mapua.edu.ph
ENABLE_EMAIL=true

# API Base URL (for approval links in emails)
API_BASE_URL=http://localhost:8000

# Service Definitions Path
SERVICES_PATH=./services

# Approval Link Expiry (hours)
APPROVAL_LINK_EXPIRY=24
