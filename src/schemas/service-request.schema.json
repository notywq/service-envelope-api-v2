{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServiceRequest",
  "type": "object",
  "required": ["id", "type", "initiator", "overallStatus", "createdAt", "lastUpdated", "envelopes"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "initiator": { "type": "string" },
    "overallStatus": {
      "type": "string",
      "enum": [
        "queued",
        "pending_approval",
        "pending_payment",
        "processing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "lastUpdated": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "timestamp", "envelope"],
        "additionalProperties": true,
        "properties": {
          "status": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "envelope": { "type": "string" }
        }
      }
    },
    "envelopes": {
      "type": "object",
      "required": ["request", "approval", "payment", "processing", "delivery", "feedback"],
      "additionalProperties": true,
      "properties": {
        "request": {
          "type": "object",
          "required": ["status", "timestamp", "sourceSystem", "validationStatus", "parameters"],
          "additionalProperties": true,
          "properties": {
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "sourceSystem": { "type": "string" },
            "validationStatus": {
              "type": "string",
              "enum": ["passed", "failed_schema", "failed_rules"]
            },
            "validationErrors": {
              "type": "array",
              "items": { "type": "string" }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "approval": {
          "type": "object",
          "required": ["required", "status", "timestamp", "approvers", "approvalRules"],
          "additionalProperties": true,
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "approvers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "role", "status"],
                "additionalProperties": true,
                "properties": {
                  "id": { "type": "string" },
                  "role": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            },
            "approvalRules": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": true,
              "properties": {
                "type": { 
                  "type": "string",
                  "enum": ["all_must_approve", "any_one", "specific_approver", "complex"]
                },
                "specificApprover": { "type": "string" },
                "requiredApprovers": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of approver emails that all must approve"
                },
                "atLeastOneOf": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "List of approver emails where at least one must approve"
                }
              }
            }
          }
        },
        "payment": {
          "type": "object",
          "required": ["required", "status", "timestamp"],
          "additionalProperties": true,
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        },
        "processing": {
          "type": "object",
          "required": ["status", "timestamp", "tasks"],
          "additionalProperties": true,
          "properties": {
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "status"],
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": "string" }
                }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "required": ["required", "status", "timestamp", "method"],
          "additionalProperties": true,
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "method": { "type": "string" }
          }
        },
        "feedback": {
          "type": "object",
          "required": ["required", "status", "timestamp"],
          "additionalProperties": true,
          "properties": {
            "required": { "type": "boolean" },
            "status": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}